DB_SERVER=your_server_hostname_or_ip
DB_PORT=1433
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no

# On-prem target (where Jira/Brex tables already live, and where the
# MGFO snapshot tables will be written for the 3-way match tool)
TARGET_DB_SERVER=your_onprem_server_hostname_or_ip
TARGET_DB_PORT=1433
TARGET_DB_NAME=your_onprem_database_name
TARGET_DB_USER=your_onprem_username
TARGET_DB_PASSWORD=your_onprem_password
TARGET_DB_DRIVER=ODBC Driver 17 for SQL Server
TARGET_DB_ENCRYPT=yes
TARGET_DB_TRUST_SERVER_CERTIFICATE=no