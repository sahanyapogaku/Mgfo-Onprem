# Manufacturo Public API
MNFO_BASE_URL=https://karman-industries.manufacturo.cloud
# Read-only key: request scopes "Nonconformance Public API read", "Equipment read",
# "Order Read", "Process Plan Read", "User Data read", "Skills read",
# "Work Center read", "Product read", "Purchase Order read" ONLY. Never
# request write/execute scopes.
MNFO_API_KEY=replace-me

# Optional. Only needed to DISCOVER new purchase order numbers (the public API
# has no bulk-list for POs — see README). Paste a fresh Bearer token captured
# from browser DevTools after logging into Manufacturo; it expires in ~5 min.
# Leave blank to skip discovery and just refresh already-known orders.
MANUFACTURO_BEARER_TOKEN=

# MSSQL connection (ODBC connection string, or set the discrete fields below)
MSSQL_DRIVER={ODBC Driver 18 for SQL Server}
MSSQL_SERVER=your-sql-server.database.windows.net
MSSQL_DATABASE=mnfo_reporting
MSSQL_UID=etl_service_account
MSSQL_PWD=replace-me
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERTIFICATE=no

# HTTP behavior
MNFO_HTTP_TIMEOUT_SECONDS=30
MNFO_MAX_RETRIES=3
MNFO_RETRY_BACKOFF_SECONDS=2

# Logging
ETL_LOG_LEVEL=INFO
ETL_LOG_FILE=logs/etl.log
